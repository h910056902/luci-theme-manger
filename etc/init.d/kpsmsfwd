#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

NAME=kpsmsfwd
PROG=/usr/bin/kpsmsfwd

start_service() {
	[ -x "$PROG" ] || return 0
	config_load "$NAME" 2>/dev/null
	local enable
	config_get enable main enable 0
	[ "$enable" = "1" ] || { echo "Instance \"$NAME\" disabled."; return 0; }

	procd_open_instance
	procd_set_param command /usr/bin/lua "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/kpsmsfwd.seen.new
}
