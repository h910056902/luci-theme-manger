#!/bin/sh /etc/rc.common
# 8080 面板配套：网页终端（ttyd）
# 背景：本固件 stock /etc/init.d/ttyd 的 procd 实例不生效（启动无进程），
#       这里用显式 command 重建，并用 respawn 保活。
# 注意：不加 -O，即允许跨源 WebSocket —— 面板(:8080) 才能内嵌 (:7681)。
#       代价：内网任意网页都能连 7681，故仅绑定 br-lan 且仅内网可达。

START=95
STOP=50
USE_PROCD=1

PROG=/usr/bin/ttyd
PORT=7681
IFACE=br-lan
INDEX=/etc/ttyd/index.html

start_service() {
	procd_open_instance
	if [ -f "$INDEX" ]; then
		procd_set_param command "$PROG" -p "$PORT" -i "$IFACE" -I "$INDEX" /bin/sh
	else
		procd_set_param command "$PROG" -p "$PORT" -i "$IFACE" /bin/sh
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	pkill -f "$PROG -p $PORT" 2>/dev/null
	return 0
}
