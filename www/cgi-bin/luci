-- PATCH-BUILD: p10-20260927
-- 补齐 quickstart 首页两个卡片被 Go `,omitempty` 抹掉的字段。
-- （2026-09-27 实证：后端硬编码查 network.interface.wan，但 C2000 的真实
--   上行是蜂窝 cpe(device eth3)；wan(eth0) 被禁用 → 零值 → 字段被省略 →
--   前端 NaN KB/s / IPv4 "-" / DNS 空。）
--
-- 本块只在 8080 反代层生效，全部 pcall 包裹；任何失败都回落「原样透传」。
-- ⚠ 必须定义成**全局函数**：挂接点在 KP-QUICKSTART-PROXY 的 do..end 作用域内，
--   块内 local 函数在那里不可见（实测踩坑）。
kp_qs_patch_read_file = function(p)
		local f = io.open(p, "r")
		if not f then return nil end
		local v = f:read("*a")
		f:close()
		if type(v) ~= "string" then return nil end
		return (v:gsub("%s+$", ""))
	end

	-- P10 / P2-2: 统一「空值」判定：nil 或 空串 都算缺失。
	kp_qs_blank = function(v)
		return v == nil or v == ""
	end

	-- 取"承载 IPv4 的真实上行接口名"：在候选里挑第一个 ipv4-address 非空的。
	kp_qs_patch_pick_iface = function(js, names)
		for _, nm in ipairs(names) do
			local s = nil
			local okn = pcall(function()
				s = require("luci.sys").exec("ubus call network.interface." .. nm .. " status")
			end)
			if okn and type(s) == "string" and #s > 0 then
				local o = nil
				pcall(function() o = js.parse(s) end)
				if type(o) == "table" then
					local a = o["ipv4-address"]
					if type(a) == "table" and type(a[1]) == "table"
					   and type(a[1].address) == "string" and a[1].address ~= "" then
						return nm, o
					end
				end
			end
		end
		return nil, nil
	end

	kp_qs_patch_pick_iface6 = function(js, names)
		for _, nm in ipairs(names) do
			local s = nil
			local okn = pcall(function()
				s = require("luci.sys").exec("ubus call network.interface." .. nm .. " status")
			end)
			if okn and type(s) == "string" and #s > 0 then
				local o = nil
				pcall(function() o = js.parse(s) end)
				if type(o) == "table" then
					local a = o["ipv6-address"]
					if type(a) == "table" and type(a[1]) == "table"
					   and type(a[1].address) == "string" and a[1].address ~= "" then
						return nm, o
					end
				end
			end
		end
		return nil, nil
	end

	-- P10 / P3-4: 真实上行 device 名（用于读 /sys/class/net/<dev>/statistics/*）
	-- 改用 luci.jsonc.parse 解析 ubus JSON（实测可用）；l3_device 优先、device 兜底。
	-- 实测接口差异：cpe 无 device key(proto=wwan)；cpe_4/cpe_6 有 l3_device+device；
	--              wan 无 l3_device(device=eth0)。
	kp_qs_patch_uplink_device = function()
		local okjs, jsp = pcall(require, "luci.jsonc")
		local names = { "cpe_4", "cpe_6", "cpe", "wan" }
		for _, nm in ipairs(names) do
			local s = nil
			local okn = pcall(function()
				s = require("luci.sys").exec("ubus call network.interface." .. nm .. " status")
			end)
			if okn and type(s) == "string" and #s > 0 then
				local d = nil
				if okjs and type(jsp) == "table" and type(jsp.parse) == "function" then
					local o = nil
					pcall(function() o = jsp.parse(s) end)
					if type(o) == "table" then
						d = o.l3_device
						if d == nil or d == "" then d = o.device end
					end
				end
				if d == nil or d == "" then
					d = s:match('"l3_device"%s*:%s*"([^"]+)"')
						or s:match('"device"%s*:%s*"([^"]+)"')
				end
				if type(d) == "string" and d ~= "" then
					if kp_qs_patch_read_file("/sys/class/net/" .. d .. "/statistics/rx_bytes") then
						return d
					end
				end
			end
		end
		return "eth0"
	end

	-- JSON 值转义（只处理字符串里可能出现的字符）
	kp_qs_patch_jesc = function(s)
		s = tostring(s)
		s = s:gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\n', '\\n'):gsub('\r', '\\r')
		return s
	end

	-- 收集设备真实网络信息（供两处共用）
	kp_qs_patch_real_net = function(js)
		local info = {}
		local nm4, o4 = kp_qs_patch_pick_iface(js, { "cpe_4", "cpe", "wan", "lan" })
		if o4 then
			local a = o4["ipv4-address"]
			if type(a) == "table" and type(a[1]) == "table" then
				info.ipv4addr = a[1].address
				if a[1].mask then info.ipv4mask = tostring(a[1].mask) end
			end
			if type(o4.proto) == "string" then info.proto = o4.proto end
			local dn = o4["dns-server"]
			if type(dn) == "table" and #dn > 0 then
				local L = {}
				for _, d in ipairs(dn) do
					if type(d) == "string" and d ~= "" then L[#L + 1] = d end
				end
				if #L > 0 then info.dnsList = L end
			end
			-- gateway：优先 route 里的 default，其次 inactive.route 的 nexthop
			local rt = o4.route
			if type(rt) == "table" then
				for _, r in ipairs(rt) do
					if type(r) == "table" and tostring(r.target) == "0.0.0.0"
					   and type(r.nexthop) == "string" then
						info.gateway = r.nexthop
						break
					end
				end
			end
			if not info.gateway then
				local ir = o4.inactive and o4.inactive.route
				if type(ir) == "table" then
					for _, r in ipairs(ir) do
						if type(r) == "table" and type(r.nexthop) == "string" then
							info.gateway = r.nexthop
							break
						end
					end
				end
			end
			if nm4 then info.iface4 = nm4 end
		end
		local nm6, o6 = kp_qs_patch_pick_iface6(js, { "cpe_6", "cpe_4", "cpe", "wan" })
		if o6 then
			local a = o6["ipv6-address"]
			if type(a) == "table" and type(a[1]) == "table"
			   and type(a[1].address) == "string" then
				info.ipv6addr = a[1].address
			end
		end
		info.dev = kp_qs_patch_uplink_device()
		info.disp = "cpe"
		return info
	end

	-- ---- (A) /u/network/status/ 响应补齐 ----
	kp_qs_patch_status = function(js, rbody)
		local o = nil
		pcall(function() o = js.parse(rbody) end)
		if type(o) ~= "table" then return rbody end
		local res = o.result
		if type(res) ~= "table" then return rbody end

		local n = kp_qs_patch_real_net(js)
		-- P10 / P2-2: Lua 里 not "" == false（空串是 truthy），后端若返回空串，
		-- 旧的 `if not res.ipv4addr` 会判 false → 静默跳过补齐。改用 kp_qs_blank。
		if kp_qs_blank(res.ipv4addr) and not kp_qs_blank(n.ipv4addr) then
			res.ipv4addr = n.ipv4addr
			res.ipv4mask = n.ipv4mask or res.ipv4mask
			res.proto = n.proto or res.proto
			res.gateway = n.gateway or res.gateway
			if res.defaultInterface == nil or res.defaultInterface == "wan" then
				res.defaultInterface = n.iface4 or n.disp
			end
		end
		if kp_qs_blank(res.ipv6addr) and not kp_qs_blank(n.ipv6addr) then res.ipv6addr = n.ipv6addr end
		if kp_qs_blank(res.proto)    and not kp_qs_blank(n.proto)    then res.proto    = n.proto    end
		if kp_qs_blank(res.gateway)  and not kp_qs_blank(n.gateway)  then res.gateway  = n.gateway  end
		if res.dnsList == nil or res.dnsList == js.null then
			if n.dnsList then res.dnsList = n.dnsList end
		end
		if res.dnsProto == nil or res.dnsProto == "" then
			res.dnsProto = "auto"
		end

		local ok_enc, s2 = pcall(function() return js.stringify(o) end)
		if ok_enc and type(s2) == "string" and #s2 > 0 then return s2 end
		return rbody
	end

	-- ---- (B) /u/network/statistics/ 响应补齐 ----
	kp_qs_patch_statistics = function(js, rbody)
		local o = nil
		pcall(function() o = js.parse(rbody) end)
		if type(o) ~= "table" then return rbody end
		local res = o.result
		if type(res) ~= "table" then return rbody end
		local items = res.items
		if type(items) ~= "table" or #items == 0 then return rbody end

		local dev = kp_qs_patch_uplink_device()
		local function rd(k)
			local v = kp_qs_patch_read_file("/sys/class/net/" .. dev .. "/statistics/" .. k)
			return tonumber(v)
		end
		-- P10 / P2-1: 采样窗口从 0.3s 降到 0.15s（降低每请求阻塞），
		-- 并统一用 WIN 变量，保证「睡眠时长」与「速率分母」一致。
		local WIN = 0.15
		local rx1, tx1 = rd("rx_bytes"), rd("tx_bytes")
		local slept = false
		pcall(function()
			local nx = require("nixio")
			if type(nx.nanosleep) == "function" then
				nx.nanosleep(0, 150000000)
				slept = true
			end
		end)
		if not slept then
			-- 兜底（仅 nixio 缺失时）：忙等 WIN 秒
			local t0 = os.clock()
			while os.clock() - t0 < WIN do end
		end
		local rx2, tx2 = rd("rx_bytes"), rd("tx_bytes")

		local ds, us = 0, 0
		if rx1 and rx2 and rx2 >= rx1 then ds = math.floor((rx2 - rx1) / WIN) end
		if tx1 and tx2 and tx2 >= tx1 then us = math.floor((tx2 - tx1) / WIN) end
		if ds < 0 then ds = 0 end
		if us < 0 then us = 0 end

		for i = 1, #items do
			if type(items[i]) ~= "table" then items[i] = {} end
			if items[i].downloadSpeed == nil then items[i].downloadSpeed = 0 end
			if items[i].uploadSpeed == nil then items[i].uploadSpeed = 0 end
		end
		local last = items[#items]
		last.downloadSpeed = ds
		last.uploadSpeed = us

		local ok_enc, s2 = pcall(function() return js.stringify(o) end)
		if ok_enc and type(s2) == "string" and #s2 > 0 then return s2 end
		return rbody
	end

	-- 挂接点：由 kp_qs_proxy() 调用（返回改写后的 body）
	kp_qs_patch_dispatch = function(pi, rbody)
		local okjs, js = pcall(require, "luci.jsonc")
		if not okjs or type(js) ~= "table" or type(js.parse) ~= "function" then
			return rbody
		end
		local out = rbody
		pcall(function()
			if pi:match("/u/network/status/$") then
				out = kp_qs_patch_status(js, rbody)
			elseif pi:match("/u/network/statistics/$") then
				out = kp_qs_patch_statistics(js, rbody)
			end
		end)
		return out
	end
-- KP-QUICKSTART-PATCH v2 END ============================================

-- KP-QUICKSTART-PROXY v2 START ===========================================
-- 8080 实例**没有 lua_prefix**（/etc/config/uhttpd 的 openwrt8080 段无该项，
-- 只有 80 端 main 有），所以 /cgi-bin/luci 是普通 CGI，无法注册 SGI handler。
-- 因此在 CGI 主体、run() 之前拦 PATH_INFO 以 /istore 开头的请求，反代到
-- quickstart 守护进程 127.0.0.1:3038（语义对齐官方 istore_backend.lua）。
--
-- ⚠ 两个实测坑（2026-09-27，勿推翻）：
--   1) uhttpd 的 cgi_prefix=/cgi-bin，**会把 SCRIPT 名剥掉**：
--      请求 /cgi-bin/luci/istore/u/x  →  PATH_INFO = /istore/u/x
--      （不是 /cgi-bin/luci/istore/u/x）
--      而 3038 的 Go 路由**挂在全前缀下**：带 /cgi-bin/luci 前缀才 200，
--      不带则 404。→ 转发时**必须把 /cgi-bin/luci 拼回**。
--   2) 3038 靠 X-Forwarded-Token 鉴权：
--        无 token            → {"success":-1001}
--        带 token（任意非空） → 真实数据（version/网络状态等）
--      所以必须从 sysauth cookie 取 sid 同时塞进 X-Forwarded-Sid 和
--      X-Forwarded-Token。
--   3) nixio.socket() 返回的是 **userdata**（不是 table），守卫不能写
--      type(s)=="table"，否则直接判定失败。
do
	local function kp_qs_proxy()
		-- 仅本实例（8080）生效
		if (os.getenv("SERVER_PORT") or "") ~= "8080" then return false end
		-- ⚠ PATH_INFO 已被 uhttpd 剥掉 /cgi-bin/luci，这里只匹配 /istore
		local pi = os.getenv("PATH_INFO") or ""
		if not pi:match("^/istore") then return false end

		local function out(status, ctype, body)
			io.write("Status: " .. status .. "\r\n")
			io.write("Content-Type: " .. ctype .. "\r\n")
			io.write("Cache-Control: no-store\r\n")
			io.write("Content-Length: " .. #body .. "\r\n\r\n")
			io.write(body)
			io.flush()
		end

		local ok_nixio, nixio = pcall(require, "nixio")
		if not ok_nixio or type(nixio) ~= "table" or type(nixio.socket) ~= "function" then
			out("502 Bad Gateway", "application/json; charset=utf-8",
			    '{"code":1,"msg":"nixio unavailable"}')
			return true
		end

		local ok_sock, sock = pcall(nixio.socket, "inet", "stream")
		-- nixio.socket() 返回 userdata，不能断言 table
		if not ok_sock or sock == nil then
			out("502 Bad Gateway", "application/json; charset=utf-8",
			    '{"code":1,"msg":"socket() failed"}')
			return true
		end

		-- ⚠ 实测本机 nixio socket 对象**无 settimeout 方法**，
		--   必须守卫后再调，否则 pcall 里报错会污染后续 connect。
		pcall(function()
			if type(sock.settimeout) == "function" then
				sock:settimeout(8)
			elseif type(sock.setblocking) == "function" then
				sock:setblocking(true)
			end
		end)

		local ok_conn, connected = pcall(function()
			return sock:connect("127.0.0.1", 3038)
		end)
		if not ok_conn or not connected then
			pcall(function() sock:close() end)
			out("502 Bad Gateway", "application/json; charset=utf-8",
			    '{"code":1,"msg":"quickstart backend unreachable on 127.0.0.1:3038"}')
			return true
		end

		local method = os.getenv("REQUEST_METHOD") or "GET"
		local qs = os.getenv("QUERY_STRING") or ""
		-- ⚠ 关键：把 /cgi-bin/luci 前缀**拼回**（3038 的路由挂在全前缀下）
		local target = "/cgi-bin/luci" .. pi
		if qs ~= "" then target = target .. "?" .. qs end

		local body = ""
		local clen = tonumber(os.getenv("CONTENT_LENGTH") or "0") or 0
		if clen > 0 and clen <= 1048576 then
			local ok_r, b = pcall(function() return io.read(clen) end)
			if ok_r and type(b) == "string" then body = b end
		end

		local cookie = os.getenv("HTTP_COOKIE") or ""
		local sid = cookie:match("sysauth=([0-9a-fA-F]+)") or ""
		-- 3038 用 X-Forwarded-Token 鉴权（实测非空即可拿到真实数据）
		local hdrs = {
			method .. " " .. target .. " HTTP/1.1",
			"Host: 127.0.0.1:3038",
			"X-Forwarded-Sid: " .. sid,
			"X-Forwarded-Token: " .. sid,
			"X-Forwarded-For: " .. (os.getenv("REMOTE_ADDR") or ""),
			"Content-Type: " .. (os.getenv("CONTENT_TYPE") or "application/json"),
			"Content-Length: " .. #body,
			"Connection: close",
			"",
			body,
		}
		local ok_send, err_send = pcall(function() return sock:send(table.concat(hdrs, "\r\n")) end)
		if not ok_send then
			pcall(function() sock:close() end)
			out("502 Bad Gateway", "application/json; charset=utf-8",
			    '{"code":1,"msg":"send failed: ' .. tostring(err_send):gsub('"', "'") .. '"}')
			return true
		end

		local chunks = {}
		while true do
			local ok_recv, chunk = pcall(function() return sock:recv(8192) end)
			if not ok_recv or type(chunk) ~= "string" or #chunk == 0 then break end
			chunks[#chunks + 1] = chunk
		end
		pcall(function() sock:close() end)
		local raw = table.concat(chunks)

		local head, rbody = raw:match("^(.-)\r\n\r\n(.*)$")
		if not head then
			out("502 Bad Gateway", "application/json; charset=utf-8",
			    '{"code":1,"msg":"bad backend response"}')
			return true
		end

		-- 解 chunked（对齐 istore_backend.lua 的 chunksource 语义）
		if head:lower():find("transfer%-encoding:%s*chunked") then
			local dec, pos = {}, 1
			while true do
				local nl = rbody:find("\r\n", pos, true)
				if not nl then break end
				local hexlen = rbody:sub(pos, nl - 1):gsub("%s", "")
				local n = tonumber(hexlen, 16)
				if not n or n <= 0 then break end
				dec[#dec + 1] = rbody:sub(nl + 2, nl + 1 + n)
				pos = nl + 2 + n + 2
			end
			rbody = table.concat(dec)
		end

		local ctype = head:match("[Cc]ontent%-[Tt]ype:%s*([^\r\n]+)")
			or "application/json; charset=utf-8"
		local code = tonumber(head:match("^HTTP/%d%.%d%s+(%d+)")) or 200
		local reasons = {
			[200] = "OK", [201] = "Created", [204] = "No Content",
			[301] = "Moved Permanently", [302] = "Found", [304] = "Not Modified",
			[400] = "Bad Request", [401] = "Unauthorized", [403] = "Forbidden",
			[404] = "Not Found", [405] = "Method Not Allowed",
			[500] = "Internal Server Error", [502] = "Bad Gateway",
			[503] = "Service Unavailable",
		}
		-- KP-QUICKSTART-PATCH v2: 补齐被 Go `,omitempty` 抹掉的字段
		if code == 200 and type(kp_qs_patch_dispatch) == "function" then
			local ok_p, patched = pcall(kp_qs_patch_dispatch, pi, rbody)
			if ok_p and type(patched) == "string" and #patched > 0 then
				rbody = patched
			end
		end

		out(code .. " " .. (reasons[code] or "Status"), ctype, rbody)
		return true
	end

	if kp_qs_proxy() then
		return
	end
end
-- KP-QUICKSTART-PROXY v2 END =============================================

-- KP-QUICKSTART-VIEWNS v3 START ==========================================
-- ⚠ 为什么必须自建 viewns、为什么挂在 parser.parse 里（2026-09-27 实测定论）：
--
-- (1) 症状：/admin/quickstart 返回 200，但 maincontent 是空的（无 div#app），
--     且响应在 sidebar 脚本后**被截断**（没有 </body></html>）。
--
-- (2) 已定论根因（2026-09-27，实测见 p4_probe_v6-v10）：
--     **main.htm 模板自身的两个坑，与 viewns 无关** ——
--       (A) Lua 注释里写了模板标签（尖括号百分号）→ 提前闭合 Lua 块 → 代码被当 HTML 直出；
--       (B) 模板内 require("luci.dispatcher") → 循环 require → cacheloader 协程被打断。
--     两者都表现为「200 静默截断」。相关规避已由私有 view/quickstart/main.htm 处理。
--
-- (3) ★ 关于 viewns：**不必自建**。
--     实测（p4_probe_v4）ctx 表跨请求复用、viewns 装一次即长期有效；
--     且真实请求里 viewns 本来就由 dispatcher 正常装配到位。
--     下面这段保留仅作**兜底**（万一某条路径 viewns 为 nil 时避免 "attempt to
--     index field 'viewns' (a nil value)"），正常不生效。
do
	local ok_tpl, tpl = pcall(require, "luci.template")
	if ok_tpl and type(tpl) == "table" and type(tpl.Template) == "table"
	   and tpl.context ~= nil then
		local ok_p, parser = pcall(require, "luci.template.parser")
		if ok_p and type(parser) == "table" and type(parser.parse) == "function" then
			local kp_orig_parse = parser.parse
			local kp_installed = false

			local function kp_install_viewns()
				if kp_installed then return end
				local ctx = tpl.context
				if type(ctx) ~= "table" then return end
				-- 已被 dispatcher 正常装配过就不动（幂等）
				if ctx.viewns ~= nil then kp_installed = true; return end

				local ok_u, util = pcall(require, "luci.util")
				local ok_h, http = pcall(require, "luci.http")
				local i18n
				pcall(function() i18n = require "luci.i18n" end)
				if not ok_u or type(util) ~= "table" then util = {} end

				local media = "/luci-static/bootstrap"
				pcall(function()
					media = require("luci.config").main.mediaurlbase or media
				end)
				local theme = media:match("([^/]+)$") or "bootstrap"

				local ok_d, disp = pcall(require, "luci.dispatcher")

				ctx.viewns = setmetatable({
					write      = (ok_h and http.write) or function(s) io.write(tostring(s or "")) end,
					include    = function(name) return tpl.Template(name):render(getfenv(2)) end,
					translate  = (i18n and i18n.translate) or function(s) return s end,
					translatef = (i18n and i18n.translatef) or function(s, ...) return s end,
					export     = function(k, v)
						if ctx.viewns[k] == nil then ctx.viewns[k] = v end
					end,
					striptags  = util.striptags or function(s) return s end,
					pcdata     = util.pcdata or function(s) return tostring(s or "") end,
					media      = media,
					theme      = theme,
					resource   = "/luci-static/resources",
					ifattr     = function(...) return "" end,
					attr       = function(...) return "" end,
					url        = (ok_d and disp.build_url) or function(...) return "" end,
				}, { __index = function(table, key)
					if key == "controller" then
						return (ok_d and disp.build_url()) or ""
					elseif key == "token" then
						local t = ""
						if ok_d then
							pcall(function()
								t = tostring(disp.context and disp.context.authsession or "")
							end)
						end
						if t == "" then
							t = (os.getenv("HTTP_COOKIE") or "")
								:match("sysauth=([0-9a-fA-F]+)") or ""
						end
						return t
					else
						return rawget(table, key) or _G[key]
					end
				end })
				kp_installed = true
			end

			parser.parse = function(path, ...)
				kp_install_viewns()
				return kp_orig_parse(path, ...)
			end
		end
	end
end
-- KP-QUICKSTART-VIEWNS v3 END ============================================

luci.dispatcher.indexcache = "/tmp/luci-indexcache-bootstrap"
luci.sgi.cgi.run()
