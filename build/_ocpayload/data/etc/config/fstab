
config global
	option anon_swap '0'
	option anon_mount '1'
	option auto_swap '1'
	option auto_mount '1'
	option delay_root '5'
	option check_fs '0'

config mount
	option device '/dev/mmcblk0p1'
	option target '/overlay'
	option ignore_uuid '1'
	option fstype 'f2fs'
	option enabled '1'
	option enabled_fsck '0'

config mount
	option device '/dev/mmcblk0p2'
	option target '/mnt/storage/data'
	option fstype 'f2fs'
	option ignore_uuid '1'
	option enabled '1'
	option enabled_fsck '0'

config swap
	option device '/overlay/swapfile'
	option enabled '1'

