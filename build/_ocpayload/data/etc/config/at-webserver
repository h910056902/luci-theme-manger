
config at-webserver 'config'
	option enabled '1'
	option connection_type 'NETWORK'
	option network_timeout '10'
	option network_allow_wan '0'
	option network_restrict_access '0'
	option serial_port '/dev/ttyUSB1'
	option serial_port_custom '/dev/ttyUSB1'
	option serial_baudrate '115200'
	option serial_timeout '10'
	option websocket_port '8765'
	option websocket_allow_wan '0'
	option cellscan_timeout '180'
	option notify_sms '1'
	option notify_call '1'
	option notify_memory_full '1'
	option notify_signal '1'
	option schedule_enabled '0'
	option schedule_check_interval '60'
	option schedule_timeout '180'
	option schedule_unlock_lte '1'
	option schedule_unlock_nr '1'
	option schedule_toggle_airplane '1'
	option schedule_night_enabled '1'
	option schedule_night_start '22:00'
	option schedule_night_end '06:00'
	option schedule_night_lte_type '3'
	option schedule_night_nr_type '3'
	option schedule_day_enabled '1'
	option schedule_day_lte_type '3'
	option schedule_day_nr_type '3'
	option network_host '127.0.0.1'
	option network_port '20250'

