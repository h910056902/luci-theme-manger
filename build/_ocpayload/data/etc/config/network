
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'
	option ula_prefix 'fd23:1b9a:0515::/48'
	option net_kind 'Priority'
	option nbcpe '1'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth2'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option netmask '255.255.255.0'
	option ip6assign '60'
	option ip6ifaceid 'eui64'
	option ipaddr '192.168.66.1'
	option def_ipaddr '192.168.66.1'
	option defaultroute '0'
	option ip6class 'local'

config interface 'wan'
	option proto 'dhcp'
	option classtype 'Wired'
	option disabled '0'
	option peerdns '1'
	option device 'eth1'
	option defaultroute '0'

config interface 'wan6'
	option proto 'dhcpv6'
	option ipv6 '0'
	option disabled '0'
	option device 'eth1'
	option defaultroute '0'

config interface 'vpn'
	option disabled '1'
	option pptp_mppe_disabled '0'
	option defaultroute '0'
	option peerdns '0'
	option checkup_interval '5'

config nrswitch 'nrswitch'
	option ovlan 'MmHNNNC'
	option dsa '1'
	option no_switch '1'
	option disable_wan '0'
	option nvlan 'WWHNNNC'

config interface 'cpe'
	option proto 'wwan'
	option defaultroute '0'
	option desc 'TD Tech MT5700'
	option odu_model 'MT5700M-CN'
	option blacklist_band '79'
	option freq_val 'nr-78:41:79:28:1:8:5:3,lte-1:3:5:8:34:38:39:40:41'
	option mobility '1'
	option freq_multi '1'
	option nrcap '1'
	option earfcn5 '1,1,2'
	option earfcn4 '1,1,2'
	option sms '1'
	option compatibility '1'
	option ippass '1'
	option nrrc '1'
	option disabled '0'

config interface 'cpe1'
	option proto 'wwan'
	option defaultroute '0'
	option phyifname 'eth0'
	option ifname 'eth0'
	option odu_interface 'nbdevice'
	option mode 'odu'
	option forcephy '1'
	option disabled '0'

config interface 'nbdevice'
	option phyifname 'eth0'
	option ifname 'eth0'
	option device 'eth0'
	option disabled '1'

config device 'eth0'
	option name 'eth0'
	option macaddr 'fc:83:c6:18:42:fb'
	option ipv6 '1'

config device 'eth1'
	option name 'eth1'
	option macaddr 'fc:83:c6:18:42:fc'
	option ipv6 '1'

config device 'eth2'
	option name 'eth2'
	option macaddr 'fc:83:c6:18:42:fa'

config interface 'docker'
	option device 'docker0'
	option proto 'none'
	option auto '0'

config device
	option type 'bridge'
	option name 'docker0'

