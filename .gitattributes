* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ipk binary
*.gz binary
*.zip binary

*.sh text eol=lf
*.lua text eol=lf
*.htm text eol=lf

# 无扩展名的可执行脚本：必须 LF，CRLF 会让 busybox ash 报
# "syntax error: unexpected word (expecting in/do)"
usr/bin/* text eol=lf
etc/init.d/* text eol=lf
